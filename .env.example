# LOCAL: leave these empty to use the no-cost practice mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# local or cloud. Cloud requires Browserbase credentials.
BROWSER_MODE=local
HEADLESS=false
# For hosting: set APP_ENV=production and use separate random invite codes.
APP_ENV=development
INVITE_CODES=
FRONTEND_ORIGIN=http://127.0.0.1:8010
PUBLIC_BACKEND_URL=http://127.0.0.1:8010
DATA_DIR=data
MAX_ACTIVE_SESSIONS=3
SESSION_MINUTES=20
MAX_CALLS_PER_INVITE=100
MAX_COST_PER_INVITE=2

# Assignment, login and resource domains, comma separated.
ALLOWED_ASSIGNMENT_HOSTS=
