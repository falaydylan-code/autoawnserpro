{
  "manifest_version": 3,
  "name": "Assignment Lab",
  "version": "0.3.1",
  "description": "Reads the assignment page you already have open and works through it one step at a time.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://positive-tranquility-production-9fdc.up.railway.app/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Assignment Lab"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
