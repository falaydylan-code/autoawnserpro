{
  "manifest_version": 3,
  "name": "Assignment Lab 2.0",
  "version": "0.9.2",
  "description": "Reads the assignment page you already have open and works through it one step at a time.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://positive-tranquility-production-9fdc.up.railway.app/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Assignment Lab 2.0",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  }
}
